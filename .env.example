# Telegram bot token from @BotFather (required)
BOT_TOKEN=
# Port for the webhook server (Docker/Render)
PORT=3000
# Optional: secret checked against X-Telegram-Bot-Api-Secret-Token (pass the same value to setWebhook)
WEBHOOK_SECRET=
# Optional: contact email sent to Nominatim in User-Agent, as their usage policy asks
NOMINATIM_EMAIL=
